# API keys — copy to `.env` in project root (never commit `.env`)

# ---------- 默认提供方（阶段 0～4 试用：Agnes 免费）----------
# 商业部署时改为 deepseek / openai / moonshot / zhipu / minimax / mimo
LLM_PROVIDER=agnes

# 网络与超时（结项实测反馈）
# 默认不读系统代理，避免 macOS SOCKS + 缺 socksio → 假 Connection error
LLM_TRUST_ENV=0
# 长日志 / Pro 推理建议 ≥300；日常 flash 用 180 也行
LLM_TIMEOUT=600
# 关闭深度思考链（Pro 类模型强烈建议开）
LLM_DISABLE_THINKING=1

AGNES_API_KEY=your-key-here
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash

# ---------- DeepSeek（长日志建议 flash；Pro 须加大超时并关思考）----------
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# # 或：DEEPSEEK_MODEL=deepseek-v4-flash

# ---------- Moonshot / Kimi ----------
# LLM_PROVIDER=moonshot
# MOONSHOT_API_KEY=your-key-here
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# MOONSHOT_MODEL=moonshot-v1-32k

# ---------- 智谱 Zhipu ----------
# LLM_PROVIDER=zhipu
# ZHIPU_API_KEY=your-key-here
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_MODEL=glm-4-flash

# ---------- MiniMax ----------
# LLM_PROVIDER=minimax
# MINIMAX_API_KEY=your-key-here
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# MINIMAX_MODEL=MiniMax-Text-01

# ---------- 小米 MiMo ----------
# LLM_PROVIDER=mimo
# MIMO_API_KEY=your-key-here
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_MODEL=mimo-v2.5

# ---------- OpenAI 兼容（预留）----------
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ---------- 安全（可选）----------
# 默认只监听 127.0.0.1。不要轻易打开局域网：
# BIND_HOST=127.0.0.1
# SECURITY_ALLOW_LAN=0
# 关闭自助注册（只保留已有账号，如 demo）：
# SECURITY_DISABLE_REGISTER=1
