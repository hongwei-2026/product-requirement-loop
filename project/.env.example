# API keys — copy to `.env` in project root (never commit `.env`)

# ---------- 默认提供方（阶段 0～4 试用：Agnes 免费）----------
# 商业部署时改为 deepseek / openai 等，不必改代码
LLM_PROVIDER=agnes

AGNES_API_KEY=your-key-here
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash

# ---------- 可选：DeepSeek（与官方 devops-code 原文一致）----------
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ---------- 安全（可选）----------
# 默认只监听 127.0.0.1。不要轻易打开局域网：
# BIND_HOST=127.0.0.1
# SECURITY_ALLOW_LAN=0
# 关闭自助注册（只保留已有账号，如 demo）：
# SECURITY_DISABLE_REGISTER=1
